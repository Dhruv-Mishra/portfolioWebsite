#!/usr/bin/env sh
# .githooks/pre-commit — Lockfile drift guard.
#
# If portfolio/package.json is staged, regenerate portfolio/package-lock.json
# (including platform-specific optional deps) and re-stage it. Prevents the
# "EUSAGE: Missing: @emnapi/* from lock file" failure on Linux CI runners
# when the lock was generated on Windows.
#
# Enable once per clone:   git config core.hooksPath .githooks
# (Run automatically by `npm run prepare` in portfolio/.)

set -e

# Only act when package.json is in this commit. Cheap and avoids running
# `npm install` on every unrelated commit.
if ! git diff --cached --name-only | grep -qE '^portfolio/package\.json$'; then
    exit 0
fi

echo "[pre-commit] portfolio/package.json changed — refreshing lockfile…"

# --package-lock-only: do not touch node_modules; just resolve and update the
# lockfile. --include=optional ensures all platform-conditional optional deps
# (e.g. @emnapi/*, @next/swc-*, lightningcss-*) are recorded for cross-OS CI.
( cd portfolio && npm install --package-lock-only --include=optional --silent )

# Re-stage if the lockfile actually changed.
if ! git diff --quiet -- portfolio/package-lock.json; then
    git add portfolio/package-lock.json
    echo "[pre-commit] package-lock.json updated and re-staged."
fi

exit 0
