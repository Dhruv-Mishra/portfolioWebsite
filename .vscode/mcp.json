{
	"servers": {
		"Headroom MCP": {
			"type": "stdio",
			"command": "${userHome}\\.local\\bin\\headroom.exe",
			"args": ["mcp", "serve"],
			"env": {
				"HEADROOM_TELEMETRY": "off",
				"HEADROOM_UPDATE_CHECK": "off"
			}
		},
		"Zvec Grep": {
			"type": "http",
			"url": "http://127.0.0.1:7999/mcp"
		}
	},
	"inputs": []
}