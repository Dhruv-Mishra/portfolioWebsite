---
import { getPageMetadata, STRUCTURED_DATA_LD } from '@/lib/metadata';
import '@/styles/globals.css';

interface Props {
  pathname?: string;
}

const pathname = Astro.props.pathname ?? Astro.url.pathname;
const metadata = getPageMetadata(pathname);
const canonicalUrl = new URL(metadata.canonical, 'https://whoisdhruv.com').toString();
const ogTitle = metadata.openGraphTitle ?? metadata.title;
const ogDescription = metadata.openGraphDescription ?? metadata.description;
const robots = metadata.robots ?? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fdfbf7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1a1a1a" />
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="dns-prefetch" href="https://v2.jokeapi.dev" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="icon" href="/icon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:site_name" content="Dhruv Mishra Portfolio" />
    <meta property="og:image" content="https://whoisdhruv.com/icon-512.png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Dhruv Mishra - Software Engineer Portfolio" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content="https://whoisdhruv.com/icon-512.png" />
    <script is:inline type="application/ld+json" set:html={STRUCTURED_DATA_LD} />
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (storedTheme === 'dark' || ((!storedTheme || storedTheme === 'system') && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="font-hand antialiased">
    <slot />
  </body>
</html>