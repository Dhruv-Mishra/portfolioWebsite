# Copy this file to .env.local and fill only what you need.
# Blank values usually disable the related feature unless noted otherwise.

# -----------------------------------------------------------------------------
# Public site config
# -----------------------------------------------------------------------------

# Public site origin used for canonical URLs and client-safe site config.
# Example: http://localhost:3000 or https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-only mirror of the site origin.
# Usually set to the same value as NEXT_PUBLIC_SITE_URL.
SITE_URL=http://localhost:3000

# Optional Google Analytics measurement ID.
# Leave blank to disable analytics.
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Optional client-side error reporting flag.
# Options: true | false
NEXT_PUBLIC_ENABLE_ERROR_TRACKING=false


# -----------------------------------------------------------------------------
# Chat providers
# -----------------------------------------------------------------------------

# Optional Groq primary provider API key.
# If set, Groq is used first for main chat.
GROQ_API_KEY=

# Optional server-only NVIDIA API key. NVIDIA powers selected NVIDIA models
# and suggestions. Provider failures return the local static fallback.
NVIDIA_API_KEY=

# Optional server-only local agent configuration. Both values are required to
# enable Qwen 3.5 4B. Docker deployments need a URL reachable from the container.
# Example: https://llm.whoisdhruv.com/v1
LOCAL_AGENT_BASE_URL=
LOCAL_AGENT_API_KEY=

# Optional OpenAI-compatible legacy compatibility provider. It is tried only
# after the built-in NVIDIA fallback for text-only chat requests.
LLM_API_KEY=

# OpenAI-compatible chat base URL.
# Example: https://integrate.api.nvidia.com/v1
LLM_BASE_URL=

# OpenAI-compatible legacy chat model.
# Example: qwen/qwen3.5-122b-a10b
LLM_MODEL=

# Optional secondary fallback model toggle.
# Options: true | false
LLM_ENABLE_FALLBACK_MODEL=false

# Optional fallback provider API key.
LLM_FALLBACK_API_KEY=

# Optional fallback provider base URL.
LLM_FALLBACK_BASE_URL=

# Optional fallback chat model.
LLM_FALLBACK_MODEL=

# -----------------------------------------------------------------------------
# Advisory model health readback
# -----------------------------------------------------------------------------

# Optional private GitHub snapshot repository. Leave these values blank to
# disable advisory readback; chat routing and deployment remain unaffected.
GITHUB_MODEL_HEALTH_REPO=Dhruv-Mishra/portfolio-model-health
GITHUB_MODEL_HEALTH_TOKEN=

# Required when advisory readback is enabled. Options: staging | production.
MODEL_HEALTH_ENVIRONMENT=staging

# -----------------------------------------------------------------------------
# Embeddings / retrieval
# -----------------------------------------------------------------------------

# Optional embeddings API key.
# Falls back to LLM_API_KEY when blank.
EMBEDDINGS_API_KEY=

# Optional embeddings base URL.
# Falls back to LLM_BASE_URL when blank.
EMBEDDINGS_BASE_URL=

# Optional embeddings model.
# Default: text-embedding-3-small
EMBEDDINGS_MODEL=text-embedding-3-small

# Optional embeddings mode.
# Options: local | blank
# local = deterministic offline embeddings for dev/CI, not production quality.
EMBEDDINGS_MODE=

# Optional build skip flag.
# Options: 1 | blank
# 1 = skip regeneration and reuse the committed embeddings bundle.
SKIP_EMBEDDINGS_BUILD=


# -----------------------------------------------------------------------------
# GitHub-backed feedback / guestbook / matrix notes
# -----------------------------------------------------------------------------

# GitHub token with Issues write access for feedback submissions.
GITHUB_FEEDBACK_TOKEN=

# Feedback repo in owner/repo form. Use a private repo if the optional
# contact field is retained because contact is written into the issue body.
# Example: your-user/portfolio-feedback
GITHUB_FEEDBACK_REPO=

# Optional guestbook token.
# Falls back to GITHUB_FEEDBACK_TOKEN when blank.
GITHUB_GUESTBOOK_TOKEN=

# Optional guestbook repo in owner/repo form.
# Falls back to GITHUB_FEEDBACK_REPO when blank.
GITHUB_GUESTBOOK_REPO=

# Optional matrix notes token.
# Falls back to guestbook, then feedback token when blank.
GITHUB_MATRIX_NOTES_TOKEN=

# Optional matrix notes repo in owner/repo form.
# Falls back to guestbook, then feedback repo when blank.
GITHUB_MATRIX_NOTES_REPO=


# -----------------------------------------------------------------------------
# Security / origin controls
# -----------------------------------------------------------------------------

# Strong random secret for signed chat history.
# Recommended in all non-trivial deployments.
CHAT_HISTORY_SIGNING_SECRET=

# Strong random secret for admin unlock cookies.
# Falls back to CHAT_HISTORY_SIGNING_SECRET when blank.
ADMIN_UNLOCK_SECRET=

# Strong random secret for Matrix Notes access cookies.
# Required in production; development and tests use an explicit local fallback.
MATRIX_NOTES_ACCESS_SECRET=

# Optional comma-separated extra allowed origins for POST APIs.
# Example: https://preview.example.com,https://staging.example.com
ALLOWED_ORIGINS=

# Optional raw diagnostics flag for local debugging.
# Options: true | false
# Enables extra LLM and voice logging. Keep false in production.
LOG_RAW=false


# -----------------------------------------------------------------------------
# Build / deployment
# -----------------------------------------------------------------------------

# Optional bundle analyzer toggle.
# Options: true | false
ANALYZE=false

# Optional explicit build ID override.
# Useful for multi-VM rollouts; CI usually sets this to the git SHA.
NEXT_BUILD_ID=