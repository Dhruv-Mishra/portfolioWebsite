# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local TTS runtime artifacts
/.cache/
/tmp/
__pycache__/
/tmp/local-tts-smoke.wav

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep the secret-free setup template tracked)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Machine-specific deploy config (not tracked — lives in /etc/deploy/ on each VM)
scripts/deploy.local.conf

#other
/build-output.txt
*.md
# Keep project docs and agent customization tracked even though most ad-hoc
# package Markdown is ignored by default.
!README.md
!projectContext.md
!public/ICONS_README.md
!**/README.md
!**/AGENTS.md
!**/*.agent.md
!**/*.instructions.md
!**/*.prompt.md
!**/SKILL.md
# …except the RAG fact corpus — these power the build-time embeddings pipeline.
!content/facts/**/*.md
# …and except the LLM-crawler markdown route handlers (per llmstxt.org).
# The directory names literally end in `.md` so the route serves at /about.md
# etc. — the route.ts files inside must be tracked.
!app/**/*.md/
!app/**/*.md/**