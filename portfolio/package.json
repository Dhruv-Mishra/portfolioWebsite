{
  "name": "portfolio",
  "version": "0.48.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22",
    "npm": "10.9.8"
  },
  "scripts": {
    "predev": "node scripts/clean-next-cache.mjs",
    "dev": "next dev",
    "prebuild": "npm run build:embeddings",
    "build": "next build",
    "postbuild": "node scripts/sanitize-standalone.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "tts:smoke": "tsx scripts/smoke-local-tts.ts",
    "build:embeddings": "tsx scripts/build-embeddings.ts",
    "search:index": "zg index .. --mode direct --embedding local/potion-code-16m-v2 --ignore-file .zvec-grepignore --reset-paths",
    "search:update": "zg index .. --mode direct",
    "search:query": "zg query --human",
    "search:status": "zg status .. --mode direct",
    "search:server": "zg server on",
    "search:server:status": "zg server status --check-ready",
    "search:server:stop": "zg server off",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^0.562.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "openai": "^6.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-test-renderer": "^19.1.0",
    "@zvec/zvec-grep": "0.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "react-test-renderer": "^19.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "webpack-bundle-analyzer": {
      "ws": "^8.18.0"
    }
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "last 2 iOS versions",
    "last 2 ChromeAndroid versions",
    "not dead",
    "maintained node versions"
  ]
}
