{
  "name": "portfolio",
  "version": "0.63.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22",
    "npm": "10.9.8"
  },
  "scripts": {
    "predev": "node scripts/clean-next-cache.mjs",
    "dev": "next dev",
    "prebuild": "npm run build:embeddings",
    "build": "next build",
    "postbuild": "node scripts/sanitize-standalone.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "typecheck:native": "next typegen && tsrs --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "tts:smoke": "tsx scripts/smoke-local-tts.ts",
    "build:embeddings": "tsx scripts/build-embeddings.ts",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^0.562.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "openai": "^7.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "react-test-renderer": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "postcss": "^8.5.23",
    "zod": "^4.6.6",
    "webpack-bundle-analyzer": {
      "ws": "^8.18.0"
    }
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "last 2 iOS versions",
    "last 2 ChromeAndroid versions",
    "not dead",
    "maintained node versions"
  ]
}
