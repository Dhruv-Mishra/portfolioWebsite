GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8081
# name|url|model ids; requests route by their `model` field and unknown models use the first entry.
UPSTREAMS=text|http://127.0.0.1:8080|Qwen3.5-4B,LFM3-1.7B,gemma-4-e2b-phone,qwen3.5-4b-q4_k_m;omni|http://127.0.0.1:8082|LFM3-Omni-2B
# One shared CPU lane across both servers: concurrent prompts would only split the 4 cores.
MAX_ACTIVE=1
# Waiting requests per model.
MAX_QUEUE=8
MAX_QUEUE_WAIT_MS=40000
MAX_RUN_MS=90000
MAX_BODY_BYTES=2097152
API_KEY_FILE=/etc/llm/api-key
