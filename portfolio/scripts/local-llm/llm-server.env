LLM_MODEL=/opt/llm/models/LFM3-1.7B-QAD-Q4_0.gguf
# First alias is what /v1/models advertises (and what the site shows); the rest keep older clients working.
LLM_ALIASES=LFM3-1.7B,gemma-4-e2b-phone,qwen3.5-4b-q4_k_m
# One slot gives the lowest mean latency: prompt processing is CPU-bound, so extra slots only split the cores.
LLM_SLOTS=1
LLM_CTX=16384
LLM_UBATCH=512
LLM_KV_TYPE=f16
