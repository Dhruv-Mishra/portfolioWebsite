LLM_MODEL=/opt/llm/models/Qwen3.5-4B-Q4S-E8.gguf
# First alias is what /v1/models advertises (and what the site shows); the gateway also lists the rest so older site builds stay healthy.
LLM_ALIASES=Qwen3.5-4B,LFM3-1.7B,gemma-4-e2b-phone,qwen3.5-4b-q4_k_m
# One slot gives the lowest mean latency: prompt processing is CPU-bound, so extra slots only split the cores.
LLM_SLOTS=1
LLM_CTX=8192
LLM_UBATCH=512
LLM_KV_TYPE=f16
