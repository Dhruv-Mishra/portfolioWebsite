# /etc/deploy/sites/portfolio.conf — Site-specific deployment configuration
# One file per website hosted on this VM.
#
# Install:
#   sudo mkdir -p /etc/deploy/sites
#   sudo cp portfolio.conf.example /etc/deploy/sites/portfolio.conf
#   sudo chmod 600 /etc/deploy/sites/portfolio.conf
#   # Then edit domain, paths, and ports for your setup.
#
# To add a SECOND website on the same VM:
#   1. Copy this file:  sudo cp portfolio.conf.example /etc/deploy/sites/mysite.conf
#   2. Change SERVICE_NAME, NEXTJS_PORT (e.g. 3001), DOMAIN, paths, SSL certs
#   3. Update /etc/deploy/machine.conf resource limits (lower per-site allocations)
#   4. From the new repo: sudo deploy.sh --site mysite

# ── Identity ─────────────────────────────────────────────────────────────────
DOMAIN="whoisdhruv.com"
SERVICE_NAME="portfolio"
NEXTJS_PORT=3000

# ── Docker / Image Deployments ───────────────────────────────────────────────
# Image mode runs one container per site behind host nginx. The workflow passes
# the immutable image digest via deploy.sh --image, so this is only the local
# container name and cache ownership policy.
DOCKER_CONTAINER_NAME="portfolio"
DOCKER_CACHE_UID=1000
DOCKER_CACHE_GID=1000

# ── Repository Paths ─────────────────────────────────────────────────────────
# These are only required for legacy VM-build mode and first-run env migration.
# GIT_ROOT:     Root of the cloned git repository
# PROJECT_ROOT: The Next.js project directory (may be nested in the repo)
GIT_ROOT="/home/ubuntu/portfolioWebsite"
PROJECT_ROOT="/home/ubuntu/portfolioWebsite/portfolio"

# ── Git ──────────────────────────────────────────────────────────────────────
GIT_BRANCH="deployed/production"
GIT_REMOTE="origin"

# Keep at least 3 releases so the manual rollback workflow has one extra
# retained target beyond the immediate previous release.
RELEASE_RETENTION_COUNT=3

# ── SSL (Cloudflare Origin Certificate) ──────────────────────────────────────
SSL_CERT="/etc/ssl/cloudflare/whoisdhruv.com.pem"
SSL_KEY="/etc/ssl/cloudflare/whoisdhruv.com.key"

# ── Nginx ────────────────────────────────────────────────────────────────────
# Template file in the repo (relative to PROJECT_ROOT)
NGINX_CONF_TEMPLATE="nginx-cloudflare.conf"

# ── Pocket TTS Topology ──────────────────────────────────────────────────────
# Configure each site independently. Staging and production on the local TTS
# VM must use different private ports. Generate a shared token with:
#   openssl rand -base64 48 | tr -d '=+/' | head -c 48
#
# Local gateway node:
TTS_NODE_MODE="local"
TTS_PRIVATE_LISTEN="10.0.0.10:3100"
TTS_ALLOWED_CLIENTS="10.0.0.20,10.0.0.21/32"
TTS_BACKEND_TOKEN="REPLACE_WITH_GENERATED_TOKEN"
#
# Remote client node (replace the local-only settings above):
# TTS_NODE_MODE="remote"
# TTS_BACKEND_URL="http://10.0.0.10:3100"
# TTS_BACKEND_TOKEN="same_token_as_the_matching_local_site_gateway"

# ── Required Environment Variables ───────────────────────────────────────────
# Comma-separated. Deploy script validates these exist in .env.local.
# Leave empty to support either Groq-first (`GROQ_API_KEY`) or legacy
# OpenAI-compatible (`LLM_*`) chat configs. Set this to a comma-separated list
# if you want deploys to fail fast when specific runtime secrets are absent.
REQUIRED_ENV_VARS=""

# ── Backups & Logs ───────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7
MAX_LOG_FILES=10

# ── Variables inherited from /etc/deploy/machine.conf ────────────────────────
# These are set once per machine and shared across all sites:
#   MACHINE_USER          - System user (default: ubuntu)
#   NODE_HEAP_MB          - V8 heap limit per site (default: 350)
#   MEMORY_HIGH_MB        - systemd soft limit (local TTS >=1200; remote >=400)
#   MEMORY_MAX_MB         - systemd hard limit (local TTS >=1536; remote >=500)
#   CPU_QUOTA_PERCENT     - CPU quota per site (default: 180)
#   BUILD_NICE            - Build process nice value (default: 15)
#   BUILD_IONICE_CLASS    - Build I/O scheduling class (default: 3)
#   BUILD_HEAP_MB         - V8 heap during build (default: 512)
#   SERVICE_NICE          - Service nice value (default: 5)
